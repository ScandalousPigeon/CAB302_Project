<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane minHeight="760.0" minWidth="1000.0" styleClass="background-layer" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.syntaxio.ui.controller.ProfileController">
   <children>
      <BorderPane maxWidth="1000.0" prefHeight="760.0" prefWidth="1000.0" styleClass="background-layer">
         <top>
            <HBox alignment="CENTER_LEFT" prefHeight="108.0" spacing="18.0" BorderPane.alignment="CENTER">
               <children>
                  <ImageView fitHeight="72.0" fitWidth="72.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@images/profile-icon.png" />
                     </image>
                  </ImageView>
                  <VBox spacing="4.0">
                     <children>
                        <Label text="Profile Preferences" textFill="#ffc700">
                           <font>
                              <Font size="34.0" />
                           </font>
                        </Label>
                        <Label fx:id="usernameLabel" text="Guest" textFill="#c8d6e5">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#handleBack" prefHeight="44.0" prefWidth="112.0" styleClass="secondary-button" text="Back" />
               </children>
               <padding>
                  <Insets bottom="20.0" left="32.0" right="32.0" top="28.0" />
               </padding>
            </HBox>
         </top>
         <center>
            <VBox spacing="18.0" styleClass="preferences-card" BorderPane.alignment="CENTER">
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label text="Learning Setup" textFill="WHITE">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </Label>
                        <Label text="Choose how Syntaxio should shape your practice experience." textFill="#9aa4bd" />
                     </children>
                  </VBox>
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="preference-label" text="Default Challenge Difficulty" />
                        <ComboBox fx:id="difficultyComboBox" maxWidth="1.7976931348623157E308" prefHeight="44.0" styleClass="preference-combo" />
                     </children>
                  </VBox>
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="preference-label" text="AI Assistant Detail" />
                        <ComboBox fx:id="assistantDetailComboBox" maxWidth="1.7976931348623157E308" prefHeight="44.0" styleClass="preference-combo" />
                     </children>
                  </VBox>
                  <CheckBox fx:id="showSolvedCheckBox" mnemonicParsing="false" styleClass="preference-checkbox" text="Show solved challenges while browsing" textFill="#e5e7eb" />
                  <HBox alignment="CENTER_LEFT" spacing="14.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#handleSavePreferences" prefHeight="46.0" prefWidth="150.0" styleClass="primary-button" text="Save" />
                        <Label fx:id="statusLabel" text="" textFill="#00d6ff" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="28.0" left="32.0" right="32.0" top="28.0" />
               </padding>
               <BorderPane.margin>
                  <Insets bottom="36.0" left="32.0" right="32.0" top="8.0" />
               </BorderPane.margin>
            </VBox>
         </center>
      </BorderPane>
   </children>
   <stylesheets>
      <URL value="@css/base.css" />
      <URL value="@css/profile.css" />
   </stylesheets>
</StackPane>
